# Supabase anon client for Next.js map browsing (Phase 2)
# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API
#
# JWT signing: after migrating to asymmetric keys (ES256), regenerate anon + service_role
# here and redeploy. Mismatch (GoTrue ES256 sessions + legacy HS256 keys) breaks all
# logged-in REST calls with 500 "JWT issued at future". Run:
#   node scripts/verify-supabase-jwt-signing.mjs
# See docs/ops/supabase-jwt-signing-runbook.md

NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpX

# Service role — server-only (worker + admin Route Handlers). Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 scraper admin (D-02, D-28, D-20, D-26)
# Comma-separated operator emails for allowlist seed after migration 018 apply
OPERATOR_BOOTSTRAP_EMAILS=ops@example.com
# AES-256 key for proxy URL encryption at rest — generate: openssl rand -base64 32
SCRAPER_SECRETS_KEY=
# Optional: DataImpulse billing panel — remaining GB, plan total, or API credentials
# DATAIMPULSE_REMAINING_GB=4.5
# DATAIMPULSE_PLAN_GB=5
# DATAIMPULSE_BALANCE_USD=12.5
# DATAIMPULSE_MONTH_TRAFFIC_GB=0.22
# DATAIMPULSE_MONTH_COST_USD=0.22
# DATAIMPULSE_API_LOGIN=        # Dashboard → API Management login
# DATAIMPULSE_API_PASSWORD=     # Dashboard → API Management password
# Translation providers (server-only)
GEMINI_API_KEY=
# Default: gemini-flash-latest (gemini-2.5-flash returns 404 for new API keys)
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
# Cheap multilingual fallback model slug (OpenRouter). google/gemini-2.0-flash-001
# was retired by OpenRouter (404 "No endpoints found") — use a currently served slug.
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
