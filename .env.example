# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (Phase 3+ auth, Phase 4 favorites/alerts) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Set to "true" after enabling Apple provider in Supabase Dashboard (Phase 4 OAuth)
NEXT_PUBLIC_APPLE_OAUTH_ENABLED="false"

# Server-only — cron matcher bypasses RLS (never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# --- Web Push VAPID (Phase 4 Plan 06) ---
# Generate: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:ops@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same-as-VAPID_PUBLIC_KEY"

# Protects /api/cron/match-alerts — generate: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
