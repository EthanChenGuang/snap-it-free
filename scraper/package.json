{
  "name": "shou-man-wu-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --import tsx src/worker.ts",
    "scrape:once": "node --import tsx src/worker.ts -- --source subito --once",
    "configure:webshare": "node scripts/configure-webshare-proxy.mjs",
    "configure:chain": "node --import tsx scripts/configure-proxy-chain.mjs",
    "configure:proxy": "node --import tsx scripts/configure-proxy.mjs",
    "test:whatsapp": "node --import tsx scripts/test-whatsapp-alert.mjs",
    "test:telegram": "node --import tsx scripts/test-telegram-alert.mjs",
    "test:wechat": "node --import tsx scripts/test-wechat-channels.mjs",
    "test:wechat:all": "node --import tsx scripts/test-wechat-channels.mjs -- --all",
    "deploy:fly": "bash scripts/deploy-fly.sh",
    "logs:fly": "fly logs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "crawlee": "^3.12.0",
    "dotenv": "^16.4.0",
    "node-telegram-bot-api": "^1.2.0",
    "playwright": "^1.62.0",
    "resend": "^6.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.15",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
