# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Residential proxy for Subito anti-bot rotation (D-04)
PROXY_URL=http://user:pass@proxy.example.com:8080

# Cron: set true for 90-minute in-process schedule; false for one-shot manual runs
CRON_ENABLED=false

# Alerting — WhatsApp via CallMeBot (highest priority when configured)
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Add +34 684 72 39 62 to WhatsApp contacts
# 2. Send "I allow callmebot to send me messages" to that contact
# 3. Copy your apikey from the CallMeBot reply
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Alerting — Telegram (used when WhatsApp not configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alerting — Resend email fallback
RESEND_API_KEY=
ALERT_FROM=alerts@yourdomain.com
ALERT_TO=ops@yourdomain.com
