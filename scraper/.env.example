# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Residential proxy — failover order: DataImpulse → Webshare → Decodo
# Per-provider (preferred):
# PROXY_URL_DATAIMPULSE=http://login__cr.it:pass@gw.dataimpulse.com:823
# PROXY_URL_WEBSHARE=http://user:pass@p.webshare.io:80
# PROXY_URL_DECODO=http://user:pass@gate.decodo.com:7000
# Bootstrap primary (synced by node scripts/configure-proxy-chain.mjs):
PROXY_URL=http://user:pass@proxy.example.com:8080

# Cron: set true for 90-minute in-process schedule; false for one-shot manual runs
CRON_ENABLED=false

# Alerting — fallback chain (tries in order until one succeeds):
# Telegram → WhatsApp (CallMeBot) → PushPlus (WeChat) → Resend email

# 1. Telegram (first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. WhatsApp / CallMeBot (second)
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# 3. PushPlus / WeChat (third)
# Setup: https://www.pushplus.plus — 实名认证 required since Aug 2024
PUSHPLUS_TOKEN=
# app = PushPlus App lock-screen notification | wechat = 服务号 inbox
PUSHPLUS_CHANNEL=app
# Optional WxPusher SPT overrides PushPlus when set
WXPUSHER_SPT=

# 4. Resend email (last)
RESEND_API_KEY=
ALERT_FROM=alerts@yourdomain.com
ALERT_TO=ops@yourdomain.com
